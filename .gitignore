# git
*.exe
*.pdb
*.ilk
*.obj
*.o
*.so
*.dylib
.vs/
.idea/

# node
node_modules/
dist/
coverage/
*.tsbuildinfo

# env: never commit a populated file
.env
.env.*
!.env.example

# local infrastructure volumes
infra/.data/

# local tools downloads
tools/.cache/

# logs and temporary reports
*.log
audits/tmp/

# Angular build cache
apps/frontend/.angular/

# Playwright artifacts
apps/frontend/playwright-report/
apps/frontend/test-results/


# PID file written by npm run dev
.dev-pids.json


# scratch output from local test runs
*-out.txt
*-err.txt


# upstream snapshots captured by data/fetch-snapshots.mjs (never committed: bounded, versioned, licence-bounded)
data/
