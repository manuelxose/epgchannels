{
  "name": "@tdt/frontend",
  "version": "1.0.0",
  "description": "TDT Platform web client: catalogue, EPG and the HLS/DASH/YouTube player, consuming our own API.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:e2e": "ng build && playwright test",
    "serve:dist": "node scripts/serve-dist.mjs",
    "playback:inventory": "node scripts/playback/inventory.mjs",
    "playback:audit": "node scripts/playback/audit-parity.mjs",
    "playback:verify": "node scripts/playback/verify-independent.mjs",
    "playback:probe": "node scripts/playback/probe-our-player.mjs",
    "demo:media": "node scripts/make-demo-media.mjs",
    "demo:fixtures": "node scripts/make-demo-fixtures.mjs",
    "playback:verify-youtube": "node scripts/playback/verify-youtube-live.mjs",
    "playback:verify-youtube-switch": "node scripts/playback/verify-youtube-switch.mjs"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "hls.js": "^1.7.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@tdt/api-client": "file:../../packages/api-client",
    "dashjs": "^5.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "@playwright/test": "1.65.0"
  }
}
