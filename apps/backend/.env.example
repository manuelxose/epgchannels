# TDT Platform backend — local development environment.
# Copy to `.env` and adjust. Never commit a populated `.env`.

NODE_ENV=development
HOST=127.0.0.1
PORT=4010
API_BASE_PATH=/api/v1

# Local Docker MongoDB (replica set enabled) and Valkey/Redis.
MONGODB_URI=mongodb://127.0.0.1:27117/?replicaSet=rs0
MONGODB_DB=tdt_platform
REDIS_URL=redis://127.0.0.1:27118

LOG_LEVEL=info
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4011,http://127.0.0.1:4011
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=600
CACHE_TTL_SECONDS=30

# Set only for the first administrator creation; unset afterwards.
# ADMIN_BOOTSTRAP_TOKEN=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
# ADMIN_BOOTSTRAP_EMAIL=editor@example.invalid

JOBS_ENABLED=false
EGRESS_GUARD_ENABLED=false
EGRESS_TIMEOUT_MS=10000
EPG_REFRESH_INTERVAL_MINUTES=60
SOURCE_VERIFY_INTERVAL_MINUTES=180
