# TDT Platform — plantilla del entorno local.
#
#   cp .env.example .env      (o Copy-Item en PowerShell)
#
# Después, rellena los DOS valores marcados como OBLIGATORIOS. `.env` está
# ignorado por git: nunca se commitea.
#
# Arranque completo:  npm run infra:up   (primera vez)
#                     npm run demo       (API + web + administración)
# Detener:            Ctrl+C

NODE_ENV=development
HOST=127.0.0.1
PORT=4010
API_BASE_PATH=/api/v1

MONGODB_URI=mongodb://127.0.0.1:27117/?replicaSet=rs0
MONGODB_DB=tdt_platform
REDIS_URL=redis://127.0.0.1:27118

LOG_LEVEL=info
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=600
CACHE_TTL_SECONDS=30

# ---------------------------------------------------------------------------
# Administración — OBLIGATORIO
# ---------------------------------------------------------------------------
# Usuario del panel:  http://127.0.0.1:4200/admin
ADMIN_BOOTSTRAP_EMAIL=admin@tdt.local
ADMIN_BOOTSTRAP_PASSWORD=<OBLIGATORIO: elige una contraseña para el panel>
# Token de alta inicial (mínimo 32 caracteres). Solo se usa mientras no exista
# ningún administrador; el alta se cierra sola en cuanto hay uno.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_BOOTSTRAP_TOKEN=<OBLIGATORIO: 64 caracteres hexadecimales>

# ---------------------------------------------------------------------------
# Trabajos en segundo plano
# ---------------------------------------------------------------------------
JOBS_ENABLED=true
EGRESS_GUARD_ENABLED=false
EGRESS_TIMEOUT_MS=10000
EPG_REFRESH_INTERVAL_MINUTES=60
SOURCE_VERIFY_INTERVAL_MINUTES=180

# ---------------------------------------------------------------------------
# Guía de demostración (CONTENIDO SINTÉTICO)
# ---------------------------------------------------------------------------
# Este checkout no incluye guía descargable: las instantáneas de `data/` no se
# versionan. Con esto activo, `npm run demo` siembra una parrilla sintética
# (todos los títulos terminan en "demo") solo si la base no tiene guía vigente.
# Ponlo a false para no sembrar nada.
DEMO_SEED_GUIDE=true
DEMO_SEED_GUIDE_CHANNELS=60
DEMO_SEED_GUIDE_DAYS=3
